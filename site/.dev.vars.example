# Copy to .dev.vars for `npm run dev`. Never commit .dev.vars.
# Cloudflare's documented always-pass Turnstile TEST secret (pairs with the test site key in index.html):
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
IP_SALT=local-dev-salt
# Optional notification channels:
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# NTFY_URL=https://ntfy.sh/your-private-topic
# NTFY_TOKEN=tk_...
# RESEND_API_KEY=re_...
# NOTIFY_EMAIL_TO=you@example.com
# NOTIFY_EMAIL_FROM=RAG Shield <notify@ragshield.dev>
